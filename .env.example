# Casper Network Configuration
# Get testnet CSPR from: https://cspr.live faucet

# Server Configuration
PORT=3000
NODE_ENV=development

# Casper x402 Configuration
CASPER_PAYEE_ADDRESS=01<64-char-account-hash>
CASPER_FACILITATOR_URL=http://localhost:4022
CASPER_CAIP2_CHAIN_ID=casper:casper-test
CASPER_ASSET_PACKAGE=<64-char-hex-cep18-package-hash>

# Payment Amounts (in motes - 1 CSPR = 1000000000 motes)
# Prices are in USD equivalent CSPR
PAYMENT_PRICE_MINIMAL=1000000000
PAYMENT_PRICE_LOW=2000000000
PAYMENT_PRICE_MEDIUM=5000000000
PAYMENT_PRICE_HIGH=10000000000
PAYMENT_PRICE_PREMIUM=25000000000

# Data API Keys (optional - enhances functionality)
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# Contract Deployment (for on-chain usage logging)
CONTRACT_HASH=<deployed-contract-hash>
RPC_URL=https://node.testnet.casper.network/rpc

# x402 Protocol
X402_VERSION=2
X402_SCHEME=exact
